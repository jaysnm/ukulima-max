# Single source of truth for env vars, shared by the backend (Django) and
# frontend (Vite) apps, plus docker-compose. Copy to .env and fill in real
# values — .env itself is gitignored.
#
#   cp .env.example .env
#
# Both `docker-compose.yml` (reads .env from this directory automatically)
# and the backend settings (`environ.Env.read_env`) load this same file, so
# there is only one place to edit. The frontend dev server also loads it
# (see frontend/vite.config.ts's `envDir`) — anything the browser bundle
# needs must be prefixed VITE_.

# ── Shared ───────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-django-key-change-this
POSTGRES_PASSWORD=strongpassword123

# ── Backend (Django) ─────────────────────────────────────────────────────
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.production
SECURE_SSL_REDIRECT=True
# Point this at localhost when running the backend natively (make backend-run)
# instead of through docker-compose (which overrides it to the "db" service).
DATABASE_URL=postgres://postgres:strongpassword123@localhost:5432/ukulima
# Absolute scheme+host Wagtail needs for links it builds outside a request
# (notification emails, the editor's "view live" link). Set this to your
# real domain in production.
WAGTAILADMIN_BASE_URL=https://yourdomain.com

# ── Frontend (Vite) — must be prefixed VITE_ to be readable in the browser ─
VITE_API_URL=http://localhost:8000

# ── Docker (optional) ────────────────────────────────────────────────────
# Uncomment if `docker compose --profile web up` warns about a platform
# mismatch (common on Apple Silicon with an amd64-only cached image/builder).
# Leave unset on most machines/CI — docker-compose.yml only applies this
# when it's actually set.
# DOCKER_PLATFORM=linux/arm64
